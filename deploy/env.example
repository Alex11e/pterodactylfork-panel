# Copy to deploy/.env. The installer generates real random secrets for you.
APP_URL=https://panel.example.com
APP_KEY=REPLACE_WITH_base64_COLON_AND_32_RANDOM_BYTES_IN_BASE64
HASHIDS_SALT=REPLACE_WITH_RANDOM_HEX
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
APP_TIMEZONE=Europe/Budapest
PANEL_BIND_IP=127.0.0.1
PANEL_PORT=8080
TLS_ENABLED=true
PANEL_DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com
# Configure SMTP for password-reset emails. log mode does not deliver mail.
MAIL_MAILER=log
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
